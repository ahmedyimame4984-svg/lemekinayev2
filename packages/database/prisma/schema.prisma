}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  phone                String?                  @unique @db.VarChar(32)
  email                String?                  @unique
  name                 String?
  accountType          AccountType              @default(CUSTOMER) @map("account_type")
  emailVerifiedAt      DateTime?                @map("email_verified_at")
  status               AccountStatus            @default(PROVISIONED)
  listingRevisionsCreated SellerListingRevision[] @relation("ListingRevisionCreator")
  listingRevisionsReviewed SellerListingRevision[] @relation("ListingRevisionReviewer")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  auditLogs            AuditLog[]               @relation("AuditLogActor")
  userRoles            UserRole[]               @relation("UserRoleUser")
  assignedUserRoles    UserRole[]               @relation("UserRoleAssigner")
  sessions             Session[]
  adminSavedViews      AdminSavedView[]
  categoriesCreated    Category[]               @relation("CategoryCreatedBy")
  categoriesUpdated    Category[]               @relation("CategoryUpdatedBy")
  productTypesCreated  ProductType[]            @relation("ProductTypeCreatedBy")
  productTypesUpdated  ProductType[]            @relation("ProductTypeUpdatedBy")
  attributesCreated    AttributeDefinition[]     @relation("AttributeDefinitionCreatedBy")
  attributesUpdated    AttributeDefinition[]     @relation("AttributeDefinitionUpdatedBy")
  attributeGroupsCreated AttributeGroup[]         @relation("AttributeGroupCreatedBy")
  attributeGroupsUpdated AttributeGroup[]         @relation("AttributeGroupUpdatedBy")
  attributeAliasesCreated AttributeAlias[]        @relation("AttributeAliasCreatedBy")
  attributeAliasesUpdated AttributeAlias[]        @relation("AttributeAliasUpdatedBy")
  optionSetsCreated     AttributeOptionSet[]       @relation("AttributeOptionSetCreatedBy")
  optionSetsUpdated     AttributeOptionSet[]       @relation("AttributeOptionSetUpdatedBy")
  optionValuesCreated   AttributeOptionValue[]     @relation("AttributeOptionValueCreatedBy")
  optionValuesUpdated   AttributeOptionValue[]     @relation("AttributeOptionValueUpdatedBy")
  unitDimensionsCreated UnitDimension[]            @relation("UnitDimensionCreatedBy")
  unitDimensionsUpdated UnitDimension[]            @relation("UnitDimensionUpdatedBy")
  attributeUnitsCreated AttributeUnit[]            @relation("AttributeUnitCreatedBy")
  attributeUnitsUpdated AttributeUnit[]            @relation("AttributeUnitUpdatedBy")
  attributeValuesCreated AttributeAllowedValue[] @relation("AttributeAllowedValueCreatedBy")
  attributeValuesUpdated AttributeAllowedValue[] @relation("AttributeAllowedValueUpdatedBy")
  attributeAssignmentsCreated ProductTypeAttributeAssignment[] @relation("ProductTypeAttributeAssignmentCreatedBy")
  attributeAssignmentsUpdated ProductTypeAttributeAssignment[] @relation("ProductTypeAttributeAssignmentUpdatedBy")
  criteriaTemplatesCreated ProductTypeCriteriaTemplate[] @relation("ProductTypeCriteriaTemplateCreatedBy")
  criteriaTemplatesUpdated ProductTypeCriteriaTemplate[] @relation("ProductTypeCriteriaTemplateUpdatedBy")
  criteriaTemplateItemsCreated ProductTypeCriteriaTemplateItem[] @relation("ProductTypeCriteriaTemplateItemCreatedBy")
  criteriaTemplateItemsUpdated ProductTypeCriteriaTemplateItem[] @relation("ProductTypeCriteriaTemplateItemUpdatedBy")
  productTypeSchemasPublished ProductTypeSchemaVersion[] @relation("ProductTypeSchemaPublishedBy")
  productsCreated       Product[]                @relation("ProductCreatedBy")
  productsUpdated       Product[]                @relation("ProductUpdatedBy")
  articleRelationsCreated ArticleRelation[]       @relation("ArticleRelationCreatedBy")
  articleRelationsUpdated ArticleRelation[]       @relation("ArticleRelationUpdatedBy")
  catalogArticleImportJobs CatalogArticleImportJob[] @relation("CatalogArticleImportJobCreatedBy")
  adminImportJobs       AdminImportJob[]          @relation("AdminImportJobCreatedBy")
  productFamiliesCreated ProductFamily[]          @relation("ProductFamilyCreatedBy")
  productFamiliesUpdated ProductFamily[]          @relation("ProductFamilyUpdatedBy")
  unitsOfMeasureCreated UnitOfMeasure[]           @relation("UnitOfMeasureCreatedBy")
  unitsOfMeasureUpdated UnitOfMeasure[]           @relation("UnitOfMeasureUpdatedBy")
  productAssetsCreated  ProductAsset[]            @relation("ProductAssetCreatedBy")
  productAssetsUpdated  ProductAsset[]            @relation("ProductAssetUpdatedBy")
  brandsCreated         Brand[]                  @relation("BrandCreatedBy")
  brandsUpdated         Brand[]                  @relation("BrandUpdatedBy")
  partNumbersCreated    PartNumber[]             @relation("PartNumberCreatedBy")
  partNumbersUpdated    PartNumber[]             @relation("PartNumberUpdatedBy")
  articleIdentifiersCreated ArticleIdentifier[]  @relation("ArticleIdentifierCreatedBy")
  articleIdentifiersUpdated ArticleIdentifier[]  @relation("ArticleIdentifierUpdatedBy")
  compatibilitiesCreated VehicleCompatibility[]   @relation("VehicleCompatibilityCreatedBy")
  compatibilitiesUpdated VehicleCompatibility[]   @relation("VehicleCompatibilityUpdatedBy")
  vehicleMakesCreated  VehicleMake[]            @relation("VehicleMakeCreatedBy")
  vehicleMakesUpdated  VehicleMake[]            @relation("VehicleMakeUpdatedBy")
  vehicleModelsCreated VehicleModel[]           @relation("VehicleModelCreatedBy")
  vehicleModelsUpdated VehicleModel[]           @relation("VehicleModelUpdatedBy")
  vehicleModelDerivativesCreated VehicleModelDerivative[] @relation("VehicleModelDerivativeCreatedBy")
  vehicleModelDerivativesUpdated VehicleModelDerivative[] @relation("VehicleModelDerivativeUpdatedBy")
  vehicleGenerationFamiliesCreated VehicleGenerationFamily[] @relation("VehicleGenerationFamilyCreatedBy")
  vehicleGenerationFamiliesUpdated VehicleGenerationFamily[] @relation("VehicleGenerationFamilyUpdatedBy")
  vehicleGenerationsCreated VehicleGeneration[] @relation("VehicleGenerationCreatedBy")
  vehicleGenerationsUpdated VehicleGeneration[] @relation("VehicleGenerationUpdatedBy")
  vehicleTrimsCreated VehicleTrim[]              @relation("VehicleTrimCreatedBy")
  vehicleTrimsUpdated VehicleTrim[]              @relation("VehicleTrimUpdatedBy")
  vehicleEnginesCreated VehicleEngine[]          @relation("VehicleEngineCreatedBy")
  vehicleEnginesUpdated VehicleEngine[]          @relation("VehicleEngineUpdatedBy")
  vehicleTransmissionsCreated VehicleTransmission[] @relation("VehicleTransmissionCreatedBy")
  vehicleTransmissionsUpdated VehicleTransmission[] @relation("VehicleTransmissionUpdatedBy")
  vehicleElectricMotorsCreated VehicleElectricMotor[] @relation("VehicleElectricMotorCreatedBy")
  vehicleElectricMotorsUpdated VehicleElectricMotor[] @relation("VehicleElectricMotorUpdatedBy")
  vehicleBatteryPacksCreated VehicleBatteryPack[] @relation("VehicleBatteryPackCreatedBy")
  vehicleBatteryPacksUpdated VehicleBatteryPack[] @relation("VehicleBatteryPackUpdatedBy")
  vehicleDriveUnitsCreated VehicleDriveUnit[] @relation("VehicleDriveUnitCreatedBy")
  vehicleDriveUnitsUpdated VehicleDriveUnit[] @relation("VehicleDriveUnitUpdatedBy")
  vehicleChargingSystemsCreated VehicleChargingSystem[] @relation("VehicleChargingSystemCreatedBy")
  vehicleChargingSystemsUpdated VehicleChargingSystem[] @relation("VehicleChargingSystemUpdatedBy")
  vehicleBodyTypesCreated VehicleBodyType[]      @relation("VehicleBodyTypeCreatedBy")
  vehicleBodyTypesUpdated VehicleBodyType[]      @relation("VehicleBodyTypeUpdatedBy")
  vehicleMarketsCreated VehicleMarket[]          @relation("VehicleMarketCreatedBy")
  vehicleMarketsUpdated VehicleMarket[]          @relation("VehicleMarketUpdatedBy")
  vehicleMarketApplicabilitiesCreated VehicleConfigurationMarketApplicability[] @relation("VehicleMarketApplicabilityCreatedBy")
  vehicleMarketApplicabilitiesUpdated VehicleConfigurationMarketApplicability[] @relation("VehicleMarketApplicabilityUpdatedBy")
  vehicleConfigurationsCreated VehicleConfiguration[] @relation("VehicleConfigurationCreatedBy")
  vehicleConfigurationsUpdated VehicleConfiguration[] @relation("VehicleConfigurationUpdatedBy")
  vehicleIdentifierMappingsCreated VehicleIdentifierMapping[] @relation("VehicleIdentifierMappingCreatedBy")
  vehicleIdentifierMappingsUpdated VehicleIdentifierMapping[] @relation("VehicleIdentifierMappingUpdatedBy")
  provenanceRecordsCreated MasterDataProvenance[] @relation("MasterDataProvenanceCreatedBy")
  provenanceRecordsUpdated MasterDataProvenance[] @relation("MasterDataProvenanceUpdatedBy")
  externalMappingsCreated ExternalStandardMapping[] @relation("ExternalStandardMappingCreatedBy")
  externalMappingsUpdated ExternalStandardMapping[] @relation("ExternalStandardMappingUpdatedBy")
  localizedRecordsCreated MasterDataLocalization[] @relation("MasterDataLocalizationCreatedBy")
  localizedRecordsUpdated MasterDataLocalization[] @relation("MasterDataLocalizationUpdatedBy")
  vehicleProfiles      VehicleProfile[]
  sellerProfile        Seller?                    @relation("SellerPrimaryUser")
  sellersCreated       Seller[]                   @relation("SellerCreatedBy")
  sellersUpdated       Seller[]                   @relation("SellerUpdatedBy")
  suppliersCreated     Supplier[]                 @relation("SupplierCreatedBy")
  suppliersUpdated     Supplier[]                 @relation("SupplierUpdatedBy")
  supplierOffersCreated SupplierOffer[]            @relation("SupplierOfferCreatedBy")
  supplierOffersUpdated SupplierOffer[]            @relation("SupplierOfferUpdatedBy")
  sellerListingsCreated SellerListing[]           @relation("SellerListingCreatedBy")
  sellerListingsUpdated SellerListing[]           @relation("SellerListingUpdatedBy")
  inventoryLocationsCreated InventoryLocation[]   @relation("InventoryLocationCreatedBy")
  inventoryLocationsUpdated InventoryLocation[]   @relation("InventoryLocationUpdatedBy")
  inventoriesUpdated   Inventory[]                @relation("InventoryUpdatedBy")
  inventoryMovements   InventoryMovement[]        @relation("InventoryMovementActor")
  sellerCredential     SellerCredential?
  sellerProvisionings  SellerProvisioningToken[]
  sellerEmailVerifications SellerEmailVerificationToken[]
  sellerApplications  SellerApplication[]       @relation("SellerApplicationOwner")
  adminCredential      AdminCredential?
  adminProvisionings   AdminProvisioningToken[]
  adminAuthChallenges  AdminAuthChallenge[]

  sellerProductsCreated SellerProduct[] @relation("SellerProductCreatedBy")
  sellerProductsUpdated SellerProduct[] @relation("SellerProductUpdatedBy")

  transfersCreated SellerStockTransfer[] @relation("StockTransferCreator")
  transferReceipts SellerStockTransferReceipt[] @relation("StockTransferReceiptActor")

  sellerApplicationDraft SellerApplicationDraft?

  @@index([accountType, status, name])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(150)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  user         User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  refreshTokenHash String?   @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  mfaVerifiedAt    DateTime? @map("mfa_verified_at")
  sourceIpHash     String?   @map("source_ip_hash") @db.Char(64)
  userAgent        String?   @map("user_agent") @db.VarChar(300)
  revokedAt        DateTime? @map("revoked_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AdminCredential {
  userId              String    @id @map("user_id") @db.Uuid
  passwordHash        String    @map("password_hash")
  mfaSecretCiphertext String    @map("mfa_secret_ciphertext")
  mfaSecretNonce      String    @map("mfa_secret_nonce") @db.VarChar(24)
  mfaSecretAuthTag    String    @map("mfa_secret_auth_tag") @db.VarChar(24)
  mfaEnrolledAt       DateTime? @map("mfa_enrolled_at")
  lastTotpCounter     BigInt?   @map("last_totp_counter")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  failedMfaAttempts   Int       @default(0) @map("failed_mfa_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@map("admin_credentials")
}

model SellerCredential {
  userId              String    @id @map("user_id") @db.Uuid
  passwordHash        String    @map("password_hash")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@map("seller_credentials")
}

model SellerEmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("seller_email_verification_tokens")
}

model SellerProvisioningToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("seller_provisioning_tokens")
}

model AdminProvisioningToken {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  tokenHash      String               @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime             @map("expires_at")
  consumedAt     DateTime?            @map("consumed_at")
  failedAttempts Int                  @default(0) @map("failed_attempts")
  createdAt      DateTime             @default(now()) @map("created_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges     AdminAuthChallenge[]

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("admin_provisioning_tokens")
}

model AdminAuthChallenge {
  id                  String                  @id @default(uuid()) @db.Uuid
  userId              String                  @map("user_id") @db.Uuid
  provisioningTokenId String?                 @map("provisioning_token_id") @db.Uuid
  type                AdminAuthChallengeType
  tokenHash           String                  @unique @map("token_hash") @db.Char(64)
  expiresAt           DateTime                @map("expires_at")
  consumedAt          DateTime?               @map("consumed_at")
  failedAttempts      Int                     @default(0) @map("failed_attempts")
  createdAt           DateTime                @default(now()) @map("created_at")
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provisioningToken   AdminProvisioningToken? @relation(fields: [provisioningTokenId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@index([expiresAt])
  @@map("admin_auth_challenges")
}

model AuthThrottle {
  keyHash         String    @id @map("key_hash") @db.Char(64)
  action          String    @db.VarChar(50)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([action, updatedAt])
  @@index([blockedUntil])
  @@map("auth_throttles")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_logs")
}

model AdminSavedView {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  scope     String   @db.VarChar(80)
  name      String   @db.VarChar(100)
  state     Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, scope, name])
  @@index([ownerId, scope, updatedAt])
  @@map("admin_saved_views")
}

model Category {
  id          String           @id @default(uuid()) @db.Uuid
  parentId    String?          @map("parent_id") @db.Uuid
