}

model ReferenceSyncEntityState {
  id                  String                  @id @default(uuid()) @db.Uuid
  checkpointId        String                  @map("checkpoint_id") @db.VarChar(60)
  entityType          String                  @map("entity_type") @db.VarChar(60)
  lastCompletedCursor String?                 @map("last_completed_cursor") @db.VarChar(200)
  status              String                  @default("PENDING") @db.VarChar(30)
  recordCount         Int                     @default(0) @map("record_count")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  checkpoint          ReferenceSyncCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([checkpointId, entityType])
  @@index([checkpointId, status])
  @@map("reference_sync_entity_states")
}

model ReferenceSyncLog {
  id               String    @id @default(uuid()) @db.Uuid
  syncType         String    @map("sync_type") @db.VarChar(30)
  status           String    @db.VarChar(30)
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  cursorBefore     String?   @map("cursor_before") @db.VarChar(200)
  cursorAfter      String?   @map("cursor_after") @db.VarChar(200)
  recordsProcessed Int       @default(0) @map("records_processed")
  recordsApplied   Int       @default(0) @map("records_applied")
  recordsSkipped   Int       @default(0) @map("records_skipped")
  error            String?
  details          Json?

  @@index([syncType, status, startedAt])
  @@map("reference_sync_logs")
}



// Source-managed identities only. Never touches local articles, listings, stock or
// consumer-customized Product Type/Attribute policies when a source row retires.
model ReferenceSyncImportedRecord {
  entityType   String                     @map("entity_type") @db.VarChar(60)
  entityId     String                     @map("entity_id") @db.Uuid
  checkpointId String                     @default("autotechdoc-canonical-sync") @map("checkpoint_id") @db.VarChar(60)
  snapshotId   String?                    @map("snapshot_id") @db.VarChar(60)
  active       Boolean                    @default(true)
  lastSequence String?                    @map("last_sequence") @db.VarChar(30)
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  checkpoint   ReferenceSyncCheckpoint    @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId])
  @@index([checkpointId, entityType, snapshotId, active])
  @@map("reference_sync_imported_records")
}
