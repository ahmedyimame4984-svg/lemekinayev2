POSTGRES_DB=lemekinaye
POSTGRES_USER=lemekinaye
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=55432
DATABASE_URL=postgresql://lemekinaye:YOUR_PASSWORD@localhost:55432/lemekinaye?schema=public
NODE_ENV=development
PORT=5000
# Server-only URLs used by the portal BFFs. Do not expose them with NEXT_PUBLIC_.
ADMIN_API_BASE_URL=http://127.0.0.1:5000/api/v1
SELLER_API_BASE_URL=http://127.0.0.1:5000/api/v1
SELLER_APP_ORIGIN=http://localhost:5002
AUTH_SESSION_TTL_MINUTES=1440
AUTH_ADMIN_SESSION_TTL_MINUTES=30
AUTH_ADMIN_REFRESH_TTL_MINUTES=480
AUTH_ADMIN_ACTIVATION_TTL_MINUTES=1440
AUTH_ADMIN_CHALLENGE_TTL_MINUTES=5
AUTH_ADMIN_MAX_ATTEMPTS=5
AUTH_ADMIN_LOCK_MINUTES=15
AUTH_ADMIN_IP_MAX_ATTEMPTS=20
AUTH_ADMIN_IP_WINDOW_MINUTES=15
AUTH_SELLER_ACTIVATION_TTL_MINUTES=1440
AUTH_SELLER_MAX_ATTEMPTS=5
AUTH_SELLER_LOCK_MINUTES=15
# Generate with: openssl rand -base64 32
AUTH_MFA_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_32_BYTE_KEY
