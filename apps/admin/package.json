    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "^1.58.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
